# test: remote_list_agents
# description: Agent on server A is visible in list on server B after direct connect

## Environment

config:
  name: server_a
  host_name: host-a

config:
  name: server_b
  host_name: host-b

directory:
  name: dir_a

terminal:
  name: Ta
  config: server_a
  cwd: dir_a

terminal:
  name: Tb
  config: server_b

## Test

@Ta
> amux new test-agent --name remote-agent
> hello
hello
echo: hello

@Tb
> amux server connect 127.0.0.1:$server_a.tcp_port
Connected to 127.0.0.1:$server_a.tcp_port

@@sleep 200

@Tb
> amux list
Running agents:
  remote-agent - $dir_a.path
