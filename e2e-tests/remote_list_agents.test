# test: remote_list_agents
# description: Agent on server A is listed on server B after pairing

## Environment

config:
  name: server_a
  host_name: host-a
  lan_port: 0

config:
  name: server_b
  host_name: host-b

directory:
  name: dir_a

terminal:
  name: Ta
  config: server_a
  cwd: dir_a

terminal:
  name: Tb
  config: server_b

terminal:
  name: TpairA
  config: server_a

terminal:
  name: TpairB
  config: server_b

## Test

@Ta
> amux new test-agent --name remote-agent
> hello
hello
echo: hello

@Tb
> amux server stop
Server shutting down.

> amux server start
Server started.

@TpairA
> amux pair --listen
@@capture pairing_pin Pairing PIN:
@@capture direct_addresses LAN direct addresses:
Pairing mode active for 5 minutes.

@TpairB
> amux pair 127.0.0.1:$server_a.lan_port
> $pairing_pin

@@sleep 1500

@TpairB
@@capture authenticated_host Pairing code: Host:
@@capture fingerprint Fingerprint:
@@capture paired_peer Paired with

@@sleep 1200

@TpairA
Pairing mode ended.

@@sleep 800

@Tb
> amux list
@@retry 5000 250
Running agents:
  remote-agent [test-agent] - $dir_a.path
