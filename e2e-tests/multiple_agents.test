# test: multiple_agents
# description: Multiple agents can run concurrently on the same server

## Environment

terminal:
  name: T1

terminal:
  name: T2

## Test

# Create first agent
@T1
> amux new test-agent --name agent-alpha
> message to alpha
message to alpha
echo: message to alpha

# Create second agent (different name, same server)
@T2
> amux new test-agent --name agent-beta
> message to beta
message to beta
echo: message to beta

# Both agents remain responsive
@T1
> alpha still alive
alpha still alive
echo: alpha still alive

@T2
> beta still alive
beta still alive
echo: beta still alive
