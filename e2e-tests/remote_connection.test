# test: remote_connection
# description: Two servers connect via TCP; agent on one is accessible from the other

## Environment

config:
  name: server_a
  host_name: host-a

config:
  name: server_b
  host_name: host-b

terminal:
  name: Ta
  config: server_a

terminal:
  name: Tb
  config: server_b

## Test

# Create agent on server A
@Ta
> amux new-agent -t remote-test test-agent
> hello from server A
hello from server A
echo: hello from server A

# Server B connects to server A
@Tb
> amux connect 127.0.0.1:$server_a.tcp_port
Connected to 127.0.0.1:$server_a.tcp_port

# Subscribe to remote agent from server B (route:agent_id format)
# Server B's link name is "host-b" (its host_name, no random suffix in tests)
@Tb
> amux attach -t host-b:remote-test
hello from server A
echo: hello from server A
> hello from server B
hello from server B
echo: hello from server B

# Verify server A sees the message from B (broadcast works through remote)
@Ta
hello from server B
echo: hello from server B
