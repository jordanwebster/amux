# test: remote_connection
# description: Two paired servers can share an agent session

## Environment

config:
  name: server_a
  host_name: host-a
  tcp_port: 0

config:
  name: server_b
  host_name: host-b

terminal:
  name: Ta
  config: server_a

terminal:
  name: Tb
  config: server_b

terminal:
  name: TpairA
  config: server_a

terminal:
  name: TpairB
  config: server_b

## Test

@Ta
> amux new test-agent --name remote-test
> hello from server A
hello from server A
echo: hello from server A

@Tb
> amux server stop
Server shutting down.

> amux server start
Server started.

@TpairA
> amux pair --listen
@@capture pairing_pin Pairing PIN:
LAN direct listener: tcp_port $server_a.tcp_port
Pairing mode active for 5 minutes.

@TpairB
> amux pair --connect 127.0.0.1:$server_a.tcp_port
> $pairing_pin

@@sleep 1500

@TpairB
@@capture paired_peer PIN: Paired with

@@sleep 1200

@TpairA
Pairing mode ended.

@@sleep 800

@Tb
> amux attach remote-test
hello from server A
echo: hello from server A
> hello from server B
hello from server B
echo: hello from server B

@Ta
hello from server B
echo: hello from server B
