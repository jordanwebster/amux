# test: peer_list
# description: Peer list combines unpaired hosts found on the network with trusted peers

## Environment

config:
  name: local
  host_name: phone
  lan_discovery: true

config:
  name: remote
  host_name: nova
  lan_discovery: true

terminal:
  name: Local
  config: local

terminal:
  name: Remote
  config: remote

terminal:
  name: PairLocal
  config: local

terminal:
  name: PairRemote
  config: remote

## Test

@@sleep 1200

@Local
> amux peer list
@@contains HOST
@@contains ID
@@contains VIA
@@contains PAIRED
@@contains nova
@@contains found · on this network
@@contains pair with: amux pair nova

@PairRemote
> amux pair --listen
@@capture pairing_code Pairing PIN:

@PairLocal
> amux pair nova
> $pairing_code
@@capture authenticated_host Pairing code: Host:
@@capture fingerprint Fingerprint:
@@capture paired_host Paired with

@@sleep 1000

@Local
> amux peer list
@@contains nova
@@contains direct
@@contains yes
