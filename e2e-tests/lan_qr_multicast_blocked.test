# test: lan_qr_multicast_blocked
# description: A QR address pairs directly when multicast discovery is unavailable

## Environment

config:
  name: host
  host_name: qr-host
  lan_discovery: true

config:
  name: phone
  host_name: qr-phone
  multicast_blocked: true

terminal:
  name: HostInit
  config: host
  installation: true

terminal:
  name: HostPair
  config: host

terminal:
  name: HostAgent
  config: host

terminal:
  name: PhoneAdmin
  config: phone

terminal:
  name: PhoneAttach
  config: phone

## Test

@HostInit
> amux init
@@contains Pairing code:
@@contains On your phone, install amux, and it will find qr-host on this network.

> amux pair --cancel
Pairing mode cancelled.

@HostPair
> amux pair --qr --link
@@capture-contains pairing_link Pairing link:

@HostAgent
> amux new test-agent --name qr-agent
> hello before QR pairing
hello before QR pairing
echo: hello before QR pairing

@PhoneAdmin
> amux peer list
HOST  ID  VIA  PAIRED

> amux pair --qr-payload $pairing_link
@@contains Host: qr-host
@@contains Paired with qr-host
@@contains on this network

> amux peer list
@@contains qr-host
@@contains direct
@@contains yes

@PhoneAttach
> amux attach qr-agent
hello before QR pairing
echo: hello before QR pairing
> hello after QR pairing
hello after QR pairing
echo: hello after QR pairing

@HostAgent
hello after QR pairing
echo: hello after QR pairing
