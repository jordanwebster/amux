# test: lan_discover_pair_attach
# description: Fresh daemons discover, pair, and attach over real multicast without an account

## Environment

config:
  name: host
  host_name: lan-host
  lan_discovery: true

config:
  name: phone
  host_name: lan-phone
  lan_discovery: true

terminal:
  name: HostAdmin
  config: host
  installation: true

terminal:
  name: HostAgent
  config: host

terminal:
  name: PhoneAdmin
  config: phone

terminal:
  name: PhonePair
  config: phone

terminal:
  name: PhoneAttach
  config: phone

## Test

@HostAdmin
> amux init
@@contains Pairing code:
@@contains · valid for 15 minutes
@@contains On your phone, install amux, and it will find lan-host on this network.
@@capture-contains init_code Pairing code:

@HostAgent
> amux new test-agent --name lan-agent
> hello from the host
hello from the host
echo: hello from the host

@PhoneAdmin
> amux peer list
@@retry 15000 250
@@contains lan-host
@@contains found · on this network
@@contains pair with: amux pair lan-host

@PhonePair
> amux pair lan-host
> $init_code
@@capture authenticated_host Pairing code: Host:
@@capture fingerprint Fingerprint:
@@capture paired_host Paired with
@@exit

@PhoneAdmin
> amux peer list
@@contains lan-host
@@contains direct
@@contains yes

@PhoneAttach
> amux attach lan-agent
hello from the host
echo: hello from the host
> hello from the phone
hello from the phone
echo: hello from the phone

@HostAgent
hello from the phone
echo: hello from the phone
