# test: profile_login
# description: Device authorization binds Alice and Bob and displays name and email

## Environment

config:
  name: relay
  cloud_relay: true
  tcp_port: 0
  accounts:
    - name: alice
      tier: free
    - name: bob
      tier: free

config:
  name: local
  profiles: [personal, work]

terminal:
  name: relay
  config: relay

terminal:
  name: T1
  config: local

## Test

@relay
> amux server start --cloud --foreground
@@sleep 500

@T1
> amux --profile personal profile rename --clear
> amux --profile work profile rename --clear
> amux --profile $local.personal.id login
@@contains To authenticate, visit:
@@contains Signed in as alice@example.test. The relay shows which hosts are up; a subscription carries agents through it. Hosts on your network and over SSH work without either.

> amux --profile $local.work.id login
@@contains Signed in as bob@example.test. The relay shows which hosts are up; a subscription carries agents through it. Hosts on your network and over SSH work without either.

> amux profiles
@@retry 8000 100
Profiles:
  $local.work.id  Bob Example  bob@example.test  bound / connected (free, quic)
  $local.personal.id  Alice Example  alice@example.test  bound / connected (free, quic)
