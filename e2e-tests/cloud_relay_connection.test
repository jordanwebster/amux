# test: cloud_relay_connection
# description: Two cloud-connected servers can share an agent session through a cloud relay

## Environment

config:
  name: relay
  host_name: relay
  tcp_port: 0
  cloud_relay: true

config:
  name: server_a
  host_name: host-a
  enable_cloud_mode: true

config:
  name: server_b
  host_name: host-b
  enable_cloud_mode: true

directory:
  name: dir_a

terminal:
  name: Tr
  config: relay

terminal:
  name: Ta
  config: server_a
  cwd: dir_a

terminal:
  name: Tb
  config: server_b

terminal:
  name: TpairA
  config: server_a

terminal:
  name: TpairB
  config: server_b

## Test

@Tr
> amux server start --cloud --foreground
@@sleep 500

@Ta
> amux new test-agent --name cloud-remote
> hello from cloud A
hello from cloud A
echo: hello from cloud A

@Tb
> amux server start
Server started.

@@sleep 1500

@TpairA
> amux pair
@@capture pairing_pin Pairing PIN:
Pairing mode active for 5 minutes.

@TpairB
> amux pair --connect host-a
> $pairing_pin

@@sleep 1500

@TpairB
@@capture paired_peer PIN: Paired with

@@sleep 1200

@TpairA
Pairing mode ended.

@@sleep 800

@Tb
> amux list
@@retry 8000 200
Running agents:
  cloud-remote [test-agent] - $dir_a.path

@Tb
> amux attach cloud-remote
hello from cloud A
echo: hello from cloud A
> hello from cloud B
hello from cloud B
echo: hello from cloud B

@Ta
hello from cloud B
echo: hello from cloud B
