# test: remote_agent_ended
# description: Remote attach receives [session ended] when the agent process exits

## Environment

config:
  name: server_a
  host_name: host-a
  tcp_port: 0

config:
  name: server_b
  host_name: host-b

terminal:
  name: Ta
  config: server_a

terminal:
  name: Tb
  config: server_b

terminal:
  name: TpairA
  config: server_a

terminal:
  name: TpairB
  config: server_b

## Test

@Ta
> amux new test-agent --name ended-test
> hello
hello
echo: hello

@Tb
> amux server start
Server started.

@TpairA
> amux pair --listen
@@capture pairing_pin Pairing PIN:
LAN direct listener: tcp_port $server_a.tcp_port
Pairing mode active for 300 seconds.

@TpairB
> amux pair --connect 127.0.0.1:$server_a.tcp_port
> $pairing_pin

@@sleep 1500

@TpairB
@@capture paired_peer PIN: Paired with

@@sleep 1200

@TpairA
Pairing mode ended.

@@sleep 800

@Tb
> amux attach ended-test
hello
echo: hello

@Ta
> exit
exit
echo: exit

[session ended]

@@sleep 200

@Tb
exit
echo: exit

[session ended]
