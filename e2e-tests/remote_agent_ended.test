# test: remote_agent_ended
# description: Remote attach receives [session ended] when the agent process exits

## Environment

config:
  name: server_a
  host_name: host-a

config:
  name: server_b
  host_name: host-b

terminal:
  name: Ta
  config: server_a

terminal:
  name: Tb
  config: server_b

## Test

@Ta
> amux new test-agent --name ended-test
> hello
hello
echo: hello

@Tb
> amux server connect 127.0.0.1:$server_a.tcp_port
Connected to 127.0.0.1:$server_a.tcp_port

@@sleep 200

@Tb
> amux attach ended-test
hello
echo: hello

@Ta
> exit
exit
echo: exit

[session ended]

@@sleep 200

@Tb
exit
echo: exit

[session ended]
