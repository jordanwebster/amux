# test: remote_agent_ended
# description: Remote attach receives [session ended] when the agent process exits

## Environment

config:
  name: server_a
  host_name: host-a
  lan_port: 0

config:
  name: server_b
  host_name: host-b

terminal:
  name: Ta
  config: server_a

terminal:
  name: Tb
  config: server_b

terminal:
  name: TpairA
  config: server_a

terminal:
  name: TpairB
  config: server_b

## Test

@Ta
> amux new test-agent --name ended-test
> hello
hello
echo: hello

@Tb
> amux server stop
Server shutting down.

> amux server start
Server started.

@TpairA
> amux pair --listen
@@capture pairing_pin Pairing PIN:
@@capture direct_addresses LAN direct addresses:
Pairing mode active for 5 minutes.

@TpairB
> amux pair 127.0.0.1:$server_a.lan_port
> $pairing_pin

@@sleep 1500

@TpairB
@@capture authenticated_host Pairing code: Host:
@@capture fingerprint Fingerprint:
@@capture paired_peer Paired with

@@sleep 1200

@TpairA
Pairing mode ended.

@@sleep 800

@Tb
> amux attach ended-test
hello
echo: hello

@Ta
> exit
exit
echo: exit

[session ended]

@@sleep 200

@Tb
exit
echo: exit

[session ended]
