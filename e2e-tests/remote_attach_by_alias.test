# test: remote_attach_by_alias
# description: Attach to a remote agent by alias after direct connect

## Environment

config:
  name: server_a
  host_name: host-a

config:
  name: server_b
  host_name: host-b

terminal:
  name: Ta
  config: server_a

terminal:
  name: Tb
  config: server_b

## Test

@Ta
> amux server start
Server started.

@Tb
> amux server connect 127.0.0.1:$server_a.tcp_port
Connected to 127.0.0.1:$server_a.tcp_port

@Ta
> amux new test-agent --name remote-test
> hello from server A
hello from server A
echo: hello from server A

@@sleep 200

@Tb
> amux attach remote-test
hello from server A
echo: hello from server A
> hello from server B
hello from server B
echo: hello from server B

@Ta
hello from server B
echo: hello from server B
