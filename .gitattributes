# Golden frames are byte-contracts: tests compare them against LF-joined
# rendered strings, so checkout must never translate their line endings
# (Windows runners default to autocrlf).
crates/amux-tui/tests/golden/*.txt text eol=lf
crates/amux-cli/tests/fixtures/*.txt text eol=lf

# Replay recordings are byte-contracts as well: each manifest stores a digest of
# the recording beside it, so a checkout that translates line endings
# invalidates every hash and the recording refuses to load.
**/fixtures/**/*.jsonl text eol=lf
**/fixtures/**/*.json text eol=lf

# Baked keymaps are embedded verbatim and hashed into the keymap identity, so
# their terminators must not follow the checkout either.
crates/claude/keymaps/*.toml text eol=lf
