#!/bin/sh

set -eu

usage() {
    echo "usage: scripts/tui-evidence <output-directory>" >&2
    exit 2
}

[ "$#" -eq 1 ] || usage
[ -n "$1" ] || usage

case "$1" in
    /*) evidence_dir=$1 ;;
    *) evidence_dir=$PWD/$1 ;;
esac

script_dir=$(CDPATH='' cd "$(dirname "$0")" && pwd)
repo_root=$(CDPATH='' cd "$script_dir/.." && pwd)
mkdir -p "$evidence_dir"
evidence_dir=$(CDPATH='' cd "$evidence_dir" && pwd)

case "$evidence_dir" in
    /|"$repo_root")
        echo "refusing to write evidence into $evidence_dir" >&2
        exit 2
        ;;
esac

cd "$repo_root"

shot() {
    "$(dirname "$0")/bounded" 600 cargo run --locked --quiet -p shot --bin amux-shot -- "$@"
}

echo "Rendering the vocabulary set"
shot render vocabulary --out "$evidence_dir/vocabulary"

echo "Proving byte-for-byte repeatability"
again=$(mktemp -d)
trap 'rm -rf "$again"' EXIT
shot render vocabulary --out "$again"
for png in "$evidence_dir"/vocabulary/*.png; do
    cmp -s "$png" "$again/$(basename "$png")" || {
        echo "a second render differs: $(basename "$png")" >&2
        exit 1
    }
done
mkdir -p "$evidence_dir/tool"
shot list > "$evidence_dir/tool/list.txt"
echo "every PNG rendered twice is byte-identical" > "$evidence_dir/tool/repeatability.txt"

echo "Verifying the complete evidence tree"
shot verify "$evidence_dir"
