#!/bin/sh
# Run one of this repository's Python scripts: `py SCRIPT [ARGS...]`.
#
# The scripts are written to a Python that has tomllib, which arrived in
# 3.11, and macOS still ships 3.9 at /usr/bin/python3. Which `python3` a
# command sees depends on who started it: a login shell, a recipe and a
# worktree manager running a machine-wide hook all have different paths, and
# one of them found the system 3.9 first. That made a script pass from one
# caller and fail from another with an import error naming nothing useful,
# so the interpreter is chosen here rather than assumed. PATH comes first so
# a virtualenv or CI image wins; the absolute paths are where the usual
# installers put a newer Python when PATH is bare.

set -eu

for candidate in \
        python3 python3.14 python3.13 python3.12 python3.11 \
        /opt/homebrew/bin/python3 /usr/local/bin/python3 \
        "$HOME"/.local/bin/python3.1[1-9]; do
    if command -v "$candidate" > /dev/null 2>&1 \
            && "$candidate" -c 'import tomllib' > /dev/null 2>&1; then
        exec "$candidate" "$@"
    fi
done

exec python3 "$@"
