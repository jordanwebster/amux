#!/bin/sh
# Run one command from the user's launchd domain at normal CPU priority.
#
# macOS agent hosts may give their entire process tree a positive nice value.
# A non-privileged child cannot undo that choice, but a user launchd job starts
# at the same priority as an interactive terminal. This helper is deliberately
# private to scripts/bounded's performance opt-in.

set -eu

if [ "$#" -lt 1 ]; then
    echo "usage: $0 COMMAND [ARGS...]" >&2
    exit 64
fi

if [ "$(uname -s)" != Darwin ]; then
    exec "$@"
fi

launchctl_path=$(command -v launchctl)
state_dir=$(mktemp -d "${TMPDIR:-/tmp}/amux-normal-priority.XXXXXX")
stdout_path="$state_dir/stdout"
stderr_path="$state_dir/stderr"
status_path="$state_dir/status"
label="com.amux.normal-priority.$(id -u).$$"
workdir=$(pwd)

cleanup() {
    "$launchctl_path" remove "$label" >/dev/null 2>&1 || true
    rm -f "$stdout_path" "$stderr_path" "$status_path"
    rmdir "$state_dir" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

echo "normal-priority: relaunching performance work from nice $(ps -o ni= -p $$ | tr -d ' ') to nice 0" >&2
"$launchctl_path" submit -l "$label" -o "$stdout_path" -e "$stderr_path" -- \
    /bin/sh -c 'workdir=$1; path=$2; status_path=$3; shift 3; cd "$workdir" || exit 72; /usr/bin/env AMUX_NORMAL_PRIORITY=1 AMUX_NORMAL_PRIORITY_ACTIVE=1 PATH="$path" "$@"; command_status=$?; printf "%s\n" "$command_status" >"$status_path"; exit "$command_status"' \
    amux-normal-priority "$workdir" "$PATH" "$status_path" "$@"
"$launchctl_path" start "$label"

while "$launchctl_path" list "$label" | grep -q '"PID"'; do
    sleep 0.2
done

if [ -f "$stdout_path" ]; then
    cat "$stdout_path"
fi
if [ -f "$stderr_path" ]; then
    cat "$stderr_path" >&2
fi
if [ ! -s "$status_path" ]; then
    echo "normal-priority: launchd job ended without an exit status" >&2
    exit 70
fi
status=$(cat "$status_path")
exit "$status"
