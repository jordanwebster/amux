#!/bin/sh
# Run a repository Python script on an interpreter new enough for it:
# `scripts/python [FLAGS...] SCRIPT [ARGS...]`.
#
# These scripts read Cargo manifests with tomllib, which arrived in Python
# 3.11. macOS ships 3.9 as /usr/bin/python3, so a shell whose PATH does not
# reach a newer interpreter lands there and dies on an import line that says
# nothing about what is missing. Resolve the interpreter here, once, for every
# recipe, and look in the two prefixes a Mac keeps a newer Python in as well as
# on PATH, because the PATH is exactly what is wrong in that case.

set -eu

for name in python3.14 python3.13 python3.12 python3.11 python3; do
    for interpreter in \
        "$(command -v "$name" 2>/dev/null || true)" \
        "/opt/homebrew/bin/$name" \
        "/usr/local/bin/$name"
    do
        [ -n "$interpreter" ] && [ -x "$interpreter" ] || continue
        if "$interpreter" -c 'import tomllib' 2>/dev/null; then
            exec "$interpreter" "$@"
        fi
    done
done

echo "scripts/python: no Python 3.11 or newer found on PATH, in /opt/homebrew/bin" \
     "or in /usr/local/bin; install one (brew install python) and re-run." >&2
exit 1
