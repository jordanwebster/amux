# Generated by Cargo
# will have compiled files and executables
target


docs/deployment.md
notes/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

findings.jsonl
overnight_cleanup.py
.worktrees

# Unattended-flight state and its eventual local handoff proof are workspace
# artifacts, not source inputs.
.autopilot/
.handoff
.handoff/

# A performance run's own numbers — verdict, samples, cadence and the report
# written from them — land under target/ and are ignored with it: they belong
# to one run, and tracking them would make every run a diff. The recorded
# baselines under ios/Perf/baselines are the opposite case and are tracked on
# purpose: an invisible baseline makes re-baselining the cheapest way to turn a
# red suite green, and nobody ever sees the number get worse. Do not add a rule
# that swallows them.

# Xcode and SwiftPM per-user state beside the generated iOS project
ios/**/.swiftpm/
ios/**/xcuserdata/

# Bytecode Python leaves beside the scripts it runs
__pycache__/

# A Team ID and the bundle id to build the phone build as. This repository
# builds simulator-only and holds no signing identity, so whoever runs the
# sandbox-purchase recipe on a real phone writes this file locally; a
# committed one would build somebody else's app under their team.
ios/Signing.local.xcconfig
