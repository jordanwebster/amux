        "json": {
          "id": 2,
          "result": {
            "thread": {
              "id": "t1",
              "cliVersion": "0.157.0",
              "turns": []
            },
            "model": "gpt-5.6-luna",
            "approvalPolicy": "on-request",
            "sandbox": {
              "type": "workspaceWrite"
            },
            "reasoningEffort": null
          }
        }
      }
    },
    {
      "input": {
        "id": "p2",
        "prompt": {
          "text": "Summarise the plan."
        }
      },
