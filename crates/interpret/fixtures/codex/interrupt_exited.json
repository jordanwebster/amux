              "cliVersion": "0.157.0",
              "turns": []
            },
            "model": "gpt-5.6-luna",
            "approvalPolicy": "on-request",
            "sandbox": {
              "type": "workspaceWrite"
            },
            "reasoningEffort": null
          }
        }
      }
    },
    {
      "input": {
