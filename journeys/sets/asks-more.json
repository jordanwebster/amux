{
  "description": "The rest of the asks, one agent each: a tool server's form with several fields and one with one field, a sign-in link (from Codex: headless Claude refuses link requests), a Codex access grant, a dialog only Claude's own terminal can answer, and a Codex question with a secret answer.",
  "client": "laptop",
  "open": "linear-triage",
  "topology": {
    "hosts": [
      {
        "name": "laptop"
      }
    ],
    "settle": true,
    "agents": [
      {
        "name": "linear-triage",
        "host": "laptop",
        "kind": "claude_sdk",
        "prompt": "File the reconnect flake we found today in Linear.",
        "cwd": "amux",
        "script": {
          "model": "claude-opus-4-1-20250805",
          "models": [
            {
              "value": "claude-opus-4-1-20250805",
              "display_name": "Opus 4.1",
              "efforts": [
                "low",
                "medium",
                "high"
              ],
              "default_effort": "high"
            }
          ],
          "steps": [
            {
              "tool": {
                "name": "Read",
                "class": "exploration",
                "input": {
                  "file_path": "notes/flakes.md"
                }
              }
            },
            {
              "ask": {
                "form": {
                  "server": "linear",
                  "message": "Linear needs a few details before it can create the issue.",
                  "schema": {
                    "type": "object",
                    "properties": {
                      "team": {
                        "type": "string",
                        "title": "Team",
                        "description": "The team whose backlog the issue goes in.",
                        "enum": [
                          "FOX",
                          "CORE",
                          "APPS"
                        ]
                      },
                      "title": {
                        "type": "string",
                        "title": "Title",
                        "description": "One line, as it will read in the backlog."
                      },
                      "estimate": {
                        "type": "integer",
                        "title": "Estimate",
                        "description": "Points, if you know them."
                      },
                      "urgent": {
                        "type": "boolean",
                        "title": "Urgent",
                        "description": "Pages whoever is on call."
                      },
                      "labels": {
                        "type": "array",
                        "title": "Labels",
                        "items": {
                          "type": "string",
                          "enum": [
                            "bug",
                            "flake",
                            "client",
                            "relay"
                          ]
                        }
                      }
                    },
                    "required": [
                      "team",
                      "title"
                    ]
                  }
                }
              }
            },
            {
              "text": {
                "chunks": [
                  "Filed it in Linear."
                ]
              }
            },
            "turn_end"
          ]
        }
      },
      {
        "name": "branch-name",
        "host": "laptop",
        "kind": "claude_sdk",
        "prompt": "Open a pull request for the keepalive change.",
        "cwd": "amux",
        "script": {
          "model": "claude-opus-4-1-20250805",
          "models": [
            {
              "value": "claude-opus-4-1-20250805",
              "display_name": "Opus 4.1",
              "efforts": [
                "low",
                "medium",
                "high"
              ],
              "default_effort": "high"
            }
          ],
          "steps": [
            {
              "tool": {
                "name": "Bash",
                "class": "consequential",
                "input": {
                  "command": "git status --short",
                  "description": "Run git"
                }
              }
            },
            {
              "ask": {
                "form": {
                  "server": "github",
                  "message": "GitHub needs a name for the new branch.",
                  "schema": {
                    "type": "object",
                    "properties": {
                      "branch": {
                        "type": "string",
                        "title": "Branch",
                        "description": "Lowercase, words joined by hyphens."
                      }
                    },
                    "required": [
                      "branch"
                    ]
                  }
                }
              }
            },
            {
              "text": {
                "chunks": [
                  "Pushed the branch and opened the pull request."
                ]
              }
            },
            "turn_end"
          ]
        }
      },
      {
        "name": "relay-errors",
        "host": "laptop",
        "kind": "codex",
        "prompt": "Check the relay's error rate for the last day.",
        "cwd": "amux",
        "script": {
          "model": "gpt-5-codex",
          "models": [
            {
              "value": "gpt-5-codex",
              "display_name": "GPT-5 Codex",
              "efforts": [
                "minimal",
                "low",
                "medium",
                "high"
              ],
              "default_effort": "medium"
            }
          ],
          "steps": [
            {
              "ask": {
                "link": {
                  "server": "grafana",
                  "message": "Grafana needs you to sign in before I can read its dashboards.",
                  "url": "https://grafana.example.com/login/oauth/authorize?client_id=amux-lab&redirect_uri=https%3A%2F%2Fgrafana.example.com%2Flogin%2Fgeneric_oauth&state=lab-7f3a91"
                }
              }
            },
            {
              "text": {
                "chunks": [
                  "The relay's error rate was 0.4% over the last day, all of it during the 03:10 deploy."
                ]
              }
            },
            "turn_end"
          ]
        }
      },
      {
        "name": "cargo-cache",
        "host": "laptop",
        "kind": "codex",
        "prompt": "Vendor the dependencies so the build works offline.",
        "cwd": "amux",
        "script": {
          "model": "gpt-5-codex",
          "models": [
            {
              "value": "gpt-5-codex",
              "display_name": "GPT-5 Codex",
              "efforts": [
                "minimal",
                "low",
                "medium",
                "high"
              ],
              "default_effort": "medium"
            }
          ],
          "steps": [
            {
              "tool": {
                "class": "exploration",
                "input": {
                  "command": "cat Cargo.toml"
                }
              }
            },
            {
              "ask": {
                "grant": {
                  "reason": "Vendoring writes the crates into vendor/ and reads them from the cargo registry.",
                  "paths": [
                    "vendor/",
                    "~/.cargo/registry"
                  ]
                }
              }
            },
            {
              "text": {
                "chunks": [
                  "Vendored 214 crates into vendor/."
                ]
              }
            },
            "turn_end"
          ]
        }
      },
      {
        "name": "mcp-dialog",
        "host": "laptop",
        "kind": "claude_pty",
        "prompt": "Connect to the new tool server and list what it offers.",
        "cwd": "amux",
        "script": {
          "model": "claude-opus-4-1-20250805",
          "models": [
            {
              "value": "claude-opus-4-1-20250805",
              "display_name": "Opus 4.1",
              "efforts": [
                "low",
                "medium",
                "high"
              ],
              "default_effort": "high"
            }
          ],
          "steps": [
            {
              "ask": {
                "tool_server_dialog": {
                  "server": "linear",
                  "tool": "create_issue"
                }
              }
            }
          ]
        }
      },
      {
        "name": "deploy-token",
        "host": "laptop",
        "kind": "codex",
        "prompt": "Deploy the relay to staging.",
        "cwd": "amux",
        "script": {
          "model": "gpt-5-codex",
          "models": [
            {
              "value": "gpt-5-codex",
              "display_name": "GPT-5 Codex",
              "efforts": [
                "minimal",
                "low",
                "medium",
                "high"
              ],
              "default_effort": "medium"
            }
          ],
          "steps": [
            {
              "tool": {
                "class": "exploration",
                "input": {
                  "command": "cat deploy/staging.toml"
                }
              }
            },
            {
              "ask": {
                "question": {
                  "questions": [
                    {
                      "question": "Paste the staging deploy token.",
                      "header": "Token",
                      "options": [],
                      "other": true,
                      "secret": true
                    },
                    {
                      "question": "Which region should take the deploy first?",
                      "header": "Region",
                      "options": [
                        {
                          "label": "eu-west (Recommended)",
                          "description": "Where most phones connect from."
                        },
                        {
                          "label": "us-east",
                          "description": "The quieter region at this hour."
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "text": {
                "chunks": [
                  "Deployed to staging, eu-west first."
                ]
              }
            },
            "turn_end"
          ]
        }
      }
    ]
  }
}
