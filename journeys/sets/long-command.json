{
  "description": "A Codex agent part way through a long test run whose log runs to about 300 KB, printed a piece at a time. Open the command's row: it holds only the newest output (its first line is a late crate, and the count of lines below stays bounded) however much more the run prints. Release the run with `just tui-set long-command --door '{\"OpenGate\": {\"name\": \"tests-done\"}}'`.",
  "client": "laptop",
  "open": "test sweep",
  "topology": {
    "hosts": [
      {
        "name": "laptop"
      }
    ],
    "agents": [
      {
        "name": "test sweep",
        "host": "laptop",
        "kind": "codex",
        "cwd": "amux",
        "prompt": "Run the whole test suite and tell me what fails.",
        "script": {
          "model": "gpt-5-codex",
          "models": [
            {
              "value": "gpt-5-codex",
              "display_name": "GPT-5 Codex",
              "efforts": [
                "minimal",
                "low",
                "medium",
                "high"
              ],
              "default_effort": "medium"
            }
          ],
          "context_tokens": 182000,
          "steps": [
            {
              "tool": {
                "class": "exploration",
                "input": {
                  "command": "cat Cargo.toml"
                }
              }
            },
            {
              "text": {
                "chunks": [
                  "Running the whole suite to see what fails."
                ]
              }
            },
            {
              "tool": {
                "class": "consequential",
                "input": {
                  "command": "cargo test --workspace"
                },
                "outcome": {
                  "output": "   Compiling crate-{piece} v0.1.0 (/work/crates/crate-{piece})\ntest crate_{piece}::tests::round_trips ... ok\n",
                  "pieces": 3000
                },
                "wait_for": "tests-done"
              }
            },
            {
              "text": {
                "chunks": [
                  "Every crate's tests pass."
                ]
              }
            },
            "turn_end"
          ]
        }
      }
    ]
  }
}
